+                     records ? records->size() : size_t{0}, file_added);
+            added += file_added;
+            list << fmt::format("{} {}\n", name, std::filesystem::file_size(path, error));
+        }
+    }
+    return added;
+} catch (const std::exception& e) {
+    LOG_ERROR(Render_Vulkan, "Pipeline cache import failed: {}", e.what());
+    return 0;
+}
