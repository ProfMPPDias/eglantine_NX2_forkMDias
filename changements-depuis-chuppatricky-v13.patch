+        raw.resize(static_cast<size_t>(record_end - start));
+        file.seekg(start);
+        file.read(raw.data(), static_cast<std::streamsize>(raw.size()));
+        records.push_back({raw, raw.substr(static_cast<size_t>(key_start - start))});
+    }
